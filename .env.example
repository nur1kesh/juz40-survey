PORT=3000
# Админ панеліне кіру құпиясөзі (/admin)
ADMIN_PASSWORD=өз-құпиясөзіңіз
# OpenAI API кілті (тек серверде сақталады)
OPENAI_API_KEY=
# Қолданатын модель атауы
OPENAI_MODEL=gpt-5.6-luna

# Хостинг (Render/Railway/nginx) артында болса 1 қойыңыз — оқушылардың нақты IP-ін ажырату үшін
TRUST_PROXY=0
# Жаңа жауаптарды AI автоматты талдасын ба? 1 — иә (токен өздігінен жұмсалады), 0 немесе жоқ — тек батырма арқылы
AUTO_ANALYZE=0
# AI күндік токен лимиті (0 немесе жоқ — лимитсіз). Мысалы: 300000
AI_DAILY_TOKEN_LIMIT=0

# --- Дерекқор ---
# PostgreSQL қосылымы. Жоқ болса — data/db.json файлы қолданылады (тек әзірлеу үшін).
# Дерекқор UTF8 кодтауында болуы ШАРТ (қазақ әріптері үшін). Мысалы: postgres://user:pass@localhost:5432/juz40
DATABASE_URL=
# Бұлттық база SSL талап етсе (Neon, Supabase, Render…) 1 қойыңыз
DATABASE_SSL=0
# Бос PostgreSQL-ға алғаш қосылғанда data/db.json автоматты көшіріледі (өшіру: 0)
MIGRATE_FROM_JSON=1
# docker compose үшін
POSTGRES_PASSWORD=

# --- Қосымша (міндетті емес) ---
# Кіру куәлігіне қол қоятын құпия кілт. Жоқ болса ADMIN_PASSWORD-тан алынады; ұзын кездейсоқ жол қойған жөн.
# SESSION_SECRET=
# Файл режимінде дерек папкасы (әдепкі ./data)
# DATA_DIR=
# OpenAI-үйлесімді басқа мекенжай (прокси немесе жергілікті модель)
# OPENAI_BASE_URL=https://api.openai.com/v1
